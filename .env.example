# 复制本文件为 .env，填入真实值即可运行 agent.py
# ==========================================
#  1. 选服务商：LLM_PROVIDER
# ==========================================
#  deepseek -> 读 DEEPSEEK_* 这组变量（默认，响应快、便宜）
#  openai   -> 读 OPENAI_API_KEY / BASE_URL / MODEL（任意 OpenAI 兼容服务）

LLM_PROVIDER=deepseek

# 请求超时（秒）与重试次数：避免上游卡住时页面一直转圈
REQUEST_TIMEOUT=60
MAX_RETRIES=1

# ==========================================
#  2.1 LangSmith 可观测性（默认关闭）
# ==========================================
# LangChain / LangGraph 自动采集模型、Agent、工具和工作流调用链。
# 配置 API Key 后才允许启用追踪；不要将真实 API Key 提交到版本控制。
# 开发排障：LANGSMITH_TRACING=true + 采样率 1.0（全量）
# 生产环境：建议保持 true，但将采样率设为 0.01 ~ 0.1，降低成本与数据采集量。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=九天梧桐AI工作台
LANGSMITH_TRACING_SAMPLING_RATE=0.1

# ==========================================
#  2. DeepSeek（预设，推荐）
# ==========================================
#  deepseek-chat     ：通用对话，速度快（推荐）
#  deepseek-reasoner ：推理模型，慢一些，适合复杂推理 / 数学

DEEPSEEK_API_KEY=sk-在此填入你自己的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ==========================================
#  3. OpenAI 兼容服务（备用，LLM_PROVIDER=openai 时生效）
# ==========================================
#  - OPENAI_API_KEY：服务商颁发的 key
#  - BASE_URL：OpenAI 兼容服务的根地址，留空走 OpenAI 官方
#  - MODEL：该服务商支持的模型 id

OPENAI_API_KEY=
BASE_URL=
MODEL=gpt-3.5-turbo

# 常用 OpenAI 兼容服务（仅 base_url + model 示例）
# OpenAI 官方 : https://api.openai.com/v1                              · gpt-3.5-turbo / gpt-4o
# Moonshot    : https://api.moonshot.cn/v1                             · moonshot-v1-8k
# 通义(兼容)  : https://dashscope.aliyuncs.com/compatible-mode/v1     · qwen-plus
# 智谱 GLM    : https://open.bigmodel.cn/api/paas/v4                  · glm-4-flash
# SiliconFlow : https://api.siliconflow.cn/v1                         · Qwen/Qwen2.5-72B-Instruct
# 豆包/方舟   : https://ark.cn-beijing.volces.com/api/v3              · doubao-pro-32k
# 腾讯混元    : https://api.hunyuan.cloud.tencent.com/v1              · hunyuan-turbos

# ==========================================
#  3.1 RAG 知识库检索（可选）
# ==========================================
# 把 .md/.txt/.pdf 文档放进项目根目录 knowledge/ 文件夹（可建子目录）即可启用知识库问答；
# PDF 依赖 pypdf（已列入 requirements.txt），命中片段会标注页码；
# 无文字层的扫描版 PDF 提取不到文字，需先 OCR。
# 智能搜索 = 多路召回 + RRF 融合重排（keyword 恒可用，不依赖任何 API Key）：
#  - keyword（恒在，默认）：零依赖的关键词检索（TF-IDF），离线可运行，无需任何配置。
#  - vector（可选）：取消下面注释并填值，配好 EMBEDDING_*（任意 OpenAI 兼容的
#    embedding 服务，DeepSeek 官方不提供 embedding，可配硅基流动等）后无需改代码，
#    检索自动升级为“关键词+语义”双路真混合；没配/服务不可用则自动保持关键词单路。
#    想强制纯本地可设 EMBEDDING_PROVIDER=offline：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-xxx                      # 留空则复用上方 OPENAI_API_KEY
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1    # 官方 OpenAI 可留空
# EMBEDDING_MODEL=text-embedding-3-small        # 如 BAAI/bge-m3

# 深度搜索（Deep Research 式，网页勾选“深度搜索”或 python agent.py --deep 触发）：
# 把问题拆成多个子查询 → 逐个智能检索 → 查漏补缺（第二轮）→ 带 [n] 引用综合回答。
# RAG_RERANK=1 时普通 search_knowledge 检索也会额外做一轮 LLM 相关度重排（更费时）。
RAG_RERANK=0
RAG_PER_LIST=8         # 每路引擎先召回多少个候选再融合
RAG_RRF_K=60           # RRF 融合常数（越大越看重前排名次）
DEEP_PLAN_MAX=4        # 子查询数量上限（2~6）
DEEP_PER_QUERY=5       # 每个子查询召回片段数
DEEP_EVIDENCE=10       # 综合回答最终采纳的片段上限
DEEP_ROUND2=1          # 是否做查漏补缺（第二轮补充检索）
DEEP_RERANK=1          # 综合前是否用 LLM 对候选做相关度重排

# 分块与召回参数（一般不用改）
RAG_TOP_K=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=60

# ==========================================
#  3.0 上下文工程（Context Engineering，core/context.py）
# ==========================================
# 把五层上下文（系统提示 / 工具定义 / 历史 / 检索 / 用户输入）当成可测量、可裁剪的对象：
#   ① 系统提示分层   每块标优先级 → 自动跨块去重 → 超预算从低优先级块开始丢
#                    （必留块：时间 / 角色 / 清单；可丢块：示例 / CoT / 工具指引）
#   ② 工具上下文     按任务阶段动态注册子集 + 每个工具一句话说明（含参数约束）
#   ③ 检索上下文     查询改写 → 相关性阈值 → 来源标注（路径/页码/更新时间/相关度）→ 按段落裁剪
#   ④ 评估迭代       记录各层用量与工具调用质量：python eval/eval_context.py
# 关闭 CTX=0 时全部行为回到改造前（纯拼接、全量工具），可作为 A/B 对照
CTX=1
CTX_BUDGET=12000        # System Prompt 字符预算（实测全量约 8.5k；0=不限）
CTX_TOOL_SELECT=1       # 是否按任务阶段动态注册工具子集
CTX_SNIPPET=800         # 单个检索片段的字符上限（按段落裁剪，不生硬截断）
CTX_MIN_SCORE=0.15      # 检索相关性阈值：低于它的片段不进上下文，全部低于则提示"证据不足"
CTX_STATS=0             # 是否把上下文度量落盘到 data/context_stats.jsonl（供跨版本对比）

# ==========================================
#  3.1d 统一上传目录 + Python 查表 + 自动记忆
# ==========================================
# 管理员上传的表格统一放在这里（不设则用 app/data/uploads），表格库会一并扫描。
# 上传即自动：解析 → 生成「数据卡片」写进记忆 → 重建索引，用户马上能问。
UPLOAD_DIR=app/data/uploads
UPLOAD_MAX_MB=1024           # 单个上传文件的大小上限（1 GB）
# ADMIN_TOKEN=change-me       # 设了之后，上传/删除需带 ?token= 或 X-Admin-Token（本地可不设）
# TABLE_MEMORY_PATH=app/data/table_memory.json   # 自动记忆（数据卡片 + 问答经验）的存放位置

# ==========================================
#  3.1c 表格文件（Excel / CSV，services/spreadsheet.py）
# ==========================================
# 把 .xlsx / .xlsm / .csv / .tsv 直接放进 非结构化数据/ 目录，重建索引后即可用
# find_table → describe_table → query_tables 走 SQL 查询（与 Markdown/HTML 表格同一条链路）。
#   一个 Excel 的多个 sheet → 拆成多张表，表名形如 t_销售明细_xlsx_销售明细_月度销售_2df635
#   CSV 编码自动探测：utf-8-sig → gb18030 → utf-8 → big5（Excel 导出的 GBK 也能读）
# 单表最多收多少行 / 列（防止超大文件撑爆 SQLite）
TABLE_FILE_MAX_ROWS=200000
TABLE_FILE_MAX_COLS=200

# ==========================================
#  3.1b 向量数据库（vectordb.py）
# ==========================================
# 知识库向量**持久化**到 SQLite（app/data/vector.sqlite3）：重启不丢索引、增量更新、
# 文档删掉后旧向量自动 prune；改造前每次进程启动都要重算 embedding，且没 落盘/没索引结构。
#   local  离线零依赖：字级 + 二元组（bigram）哈希 TF-IDF，向量稳定可复现
#   api    OpenAI 兼容的 embedding（需 EMBEDDING_BASE_URL + EMBEDDING_API_KEY）
# 注：auto 只有在**同时**配了 EMBEDDING_BASE_URL 和 key 时才走 api
#    （只用对话服务的 key 去猜 embedding，多半是 503，所以不给它有罪推定）
VECTOR_DB=1
# VECTOR_DB_PATH=app/data/vector.sqlite3
VECTOR_BACKEND=auto        # auto | local | api
VECTOR_DIM=512             # local 后端的向量维度
VECTOR_IVF_MIN=5000        # 超过多少条才构建 IVF 倒排索引（0=总是，-1=关闭）
VECTOR_NPROBE=8            # IVF 探测几个簇（越大越准、越慢）
# 查看状态：python services/vectordb.py --stats    检索测试：--search "报销流程"

# ==========================================
#  3.2 规划 Planning（planning.py）
# ==========================================
# 复杂任务先拆成 2~6 步执行计划并注入提示词，模型边做边用 update_plan 勾选进度
# （网页上显示计划面板），终答前再由自检器核对是否真的做完，没做完补一轮。
#  PLAN_MODE=auto     auto=启发式判断，复杂任务才规划（默认，简单问题不多花一次调用）
#                     always=每个问题都先规划   off=关闭规划（回到“模型直接 ReAct”）
#  PLAN_MAX_STEPS=6   计划最多几步（1~12）
#  PLAN_REFLECT=1     终答前是否做一次执行自检
#  PLAN_MAX_REFLECT=1 自检后最多再继续几轮（0~3）
# 命令行也可临时覆盖：python agent.py "问题" --plan always
PLAN_MODE=auto
PLAN_MAX_STEPS=6
PLAN_REFLECT=1
PLAN_MAX_REFLECT=1

# ==========================================
#  3.3 记忆 Memory（三层）
# ==========================================
#  ① 会话内历史：Checkpointer（data/checkpoints.sqlite3），按 thread_id 隔离，完整保留；
#  ② 跨会话长期记忆：Store（data/memory.sqlite3），remember / recall / forget 三个工具读写，
#     带类型（fact/preference/task/other）、标签、重要度，recall 按相关度召回、内容重复自动合并；
#  ③ 长会话摘要：对话很长时把早期消息压成一段滚动摘要，只把「摘要 + 最近若干条原文」
#     发给模型，上下文不再越聊越长；Checkpointer 里的完整历史一条都不会删。
#  MEM_COMPACT=1          是否开启长会话摘要压缩（默认开）
#  MEM_COMPACT_AFTER=40   会话消息超过多少条开始压缩（8~2000）
#  MEM_COMPACT_KEEP=12    压缩后保留最近多少条原文（2~400）
MEM_COMPACT=1
MEM_COMPACT_AFTER=40
MEM_COMPACT_KEEP=12

# ==========================================
#  3.4 非结构化表格库（tables.py，可选）
# ==========================================
# 把 非结构化数据/ 目录里的 markdown / HTML 表格（787 张 / 120,328 行）解析成 SQLite（data/tables.sqlite3），
# 让 Agent 用只读 SQL 查询（工具：list_table_sets / find_table / describe_table / query_tables）。
# 依赖只有 Python 标准库 sqlite3，**不需要 pandas**，也不往 MySQL 里写任何东西。
# 索引在首次查询时自动构建（约 5 秒），也可手动重建：python tables.py --build
#   TABLE_DATA_DIR=非结构化数据       # 数据目录（默认项目根目录下的「非结构化数据」）
TABLE_DATA_DIR=非结构化数据

# ==========================================
#  3.5 输出脱敏（sanitize.py，默认开启）
# ==========================================
# 让回答里不出现个人关键信息：① 查询结果在喂给模型之前按列名 + 值双重判断脱敏；
# ② 最终回答（含流式逐字输出）再过一遍正则兜底；③ 出处里的 SQL（where 条件常带手机号）
# 与写回会话历史的消息同样脱敏。覆盖「给模型看的上下文 / 给用户看的回答 / 落盘的历史」三条出口。
#   SANITIZE=1          是否启用脱敏（默认开；设 0 关闭，适合查自己数据的场景）
#   SANITIZE_STRICT=1   严格模式：身份证/卡号/编号全遮、邮箱连带域名一起遮（标准模式则保留
#                       前 6 后 4、留 heads/tails 便于核对，姓名保留姓氏）
# 掩码串不会再被同一套规则命中（幂等），重复处理安全。
SANITIZE=1
SANITIZE_STRICT=0

# ==========================================
#  3.6 提示词工程 Prompt Engineering（prompting.py，默认开启）
# ==========================================
# NL→SQL 的错大多不是语法错，是"没听懂"：时间口径（自然月 or 近 30 天）、
# 计数去不去重、"最好"按什么排、"它的趋势呢"里的"它"指谁。prompting.py 在正式取数前
# 用一次便宜的结构化调用把这些问题消歧成 QuerySpec（时间落成具体日期、口径、排序、
# 歧义与默认假设），注入当轮提示词，后置 Route 取数就不容易跑偏。
# 同时把散落的规则收敛成两份清单注入 System Prompt：写 SQL 前必查 / 回答前必查。
#   QUND=1  是否启用查询理解（默认开；设 0 关闭）
#           只对「像在问数据」的问题触发，打招呼 / 纯算术不会多花这次调用；
#           理解失败（模型不可用 / 返回非 JSON）会静默降级，不影响正常问答。
# 自检：python prompting.py
QUND=1

# ==========================================
#  3.7 推理与规划（core/reasoning.py）
# ==========================================
# 在既有 ReAct 循环 + Plan-and-Execute 之上，补上「多条候选之间择优」与「反思记忆」：
#   CoT        注入「事实→推断→动作→校验」四拍节拍（纯文本，零调用开销）
#   ToT        每层生成多条不同的解题路线 → 自评打分 → beam 剪枝，取最优路径
#   MCTS       UCB1 选择 → 扩展 → 模拟评分 → 反向传播，迭代出更耐用的计划
#   Reflexion  每次自检的建议入账，下次自检带历史，避免重复踩同一个坑
# 只对「复杂任务」（由 planning.needs_plan 判定）启用树搜索，简单问答不多花调用；
# 任何环节失败都静默降级为单条计划 / 不规划。自检：python core/reasoning.py
REASON_MODE=auto        # auto（默认，复杂任务才上树搜索）| react | cot | tot | mcts
REASON_COT=1            # 是否注入思维链节拍提示词
TOT_BREADTH=3           # ToT 每层候选路线数
TOT_DEPTH=2             # ToT 层数
MCTS_ITERS=4            # 蒙特卡洛树迭代次数（每轮一次扩展调用）
MCTS_MAX_STEPS=6        # MCTS 生成的计划最多几步

# ==========================================
#  3.8 受限 Python 沙箱（services/pysandbox.py，run_python 工具）
# ==========================================
# 允许：四则、推导式、math / statistics / numpy、若干安全内置函数
# 禁止：import、open、eval/exec/getattr/globals、下划线属性、while 循环
# 防跑飞：循环体插桩计数，超过下值（默认 50 万步）直接中止
SANDBOX_TIMEOUT=3
SANDBOX_MAX_STEPS=500000

# ==========================================
#  4. MySQL 业务库查询（agent.py 的 execute_sql 工具）
# ==========================================
# 本机三个业务库：financial_asset_management / healthcare_analytics_competition / telecom_operations_db
# execute_sql 为只读（SELECT/SHOW/DESCRIBE/EXPLAIN/WITH），未配置时默认连 localhost:3306 root/123456
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
